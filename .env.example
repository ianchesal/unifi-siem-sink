# Required
MCP_SECRET=choose-a-strong-secret-here

# Optional
SYSLOG_UDP_PORT=10514
SYSLOG_BIND_ADDRESS=0.0.0.0
MCP_PORT=3000
MCP_HOST=0.0.0.0
# DB_PATH is set by the Docker image for container deployments (/data/events.db, backed by
# the siem-data volume); only override this for local (non-Docker) runs.
# DB_PATH=./data/events.db
RETENTION_DAYS=90
MAX_MESSAGE_BYTES=16384
LOG_LEVEL=info
